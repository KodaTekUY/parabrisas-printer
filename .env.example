SYSTEM_API_URL=https://test.example.com
PRINT_AGENT_API_KEY=replace-with-a-long-random-secret
PRINT_AGENT_ID=xp470l-01

# Nombres exactos; configurar solo las impresoras que atiende esta instalación.
PRINTERS='[{"name":"Mostrador 1","ip":"192.168.1.51"},{"name":"Mostrador 2","ip":"192.168.1.52"},{"name":"Facturación","ip":"192.168.1.50"},{"name":"Pista","ip":"192.168.1.53"}]'
PRINTER_PORT=9100
PRINTER_DPI=203
PRINTER_ENCODING=utf-8
PRINTER_CODEPAGE=UTF-8
PRINTER_TIMEOUT_SECONDS=5

POLL_INTERVAL_SECONDS=2
API_TIMEOUT_SECONDS=15

# Logs: nivel, cantidad total de archivos (activo incluido) y zona horaria Docker.
LOG_LEVEL=INFO
LOG_RETENTION_FILES=14
TZ=America/Montevideo
# Para ejecución directa con Python; Docker monta ./logs en /app/logs.
LOG_DIR=logs
